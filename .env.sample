# Zelretch - UserBot
# .env.sample - legacy compatibility (the web setup wizard is the recommended path).
#
# You DO NOT need to fill this file in. Zelretch reads its configuration from
# the database you pick in the setup wizard. If you do provide values here,
# they will be imported into the DB on first run, then ignored.

# Mandatory for the userbot.
API_ID=
API_HASH=
SESSION=

# Optional assistant bot (enables dual-mode).
BOT_TOKEN=

# Pick one database backend. If left blank, Zelretch uses a local JSON file.
DATABASE_TYPE=local
# DATABASE_URL=postgres://user:pass@host:5432/db
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
# REDIS_URI=host:port
# REDIS_PASSWORD=

# Runtime preferences.
HNDLR=.
DUAL_HNDLR=/
LOG_CHANNEL=
LANGUAGE=en

# Deployment platform (auto-detected if left blank).
HOSTED_ON=local
