"""Interactive Kurigram session string generator.

Run with::

    python sessiongen

The script asks for API credentials, logs into Telegram (via login code +
optional 2FA password) and prints a session string you can paste into the
Zelretch setup wizard's Session step.
"""

from __future__ import annotations

import asyncio
import os
import sys


def _banner() -> None:
    print("""
            ┏┳┓╋┏┓╋╋╋╋┏┓┏┓
            ┃┃┣┓┃┗┳┳┳━╋╋┛┃
            ┃┃┃┗┫┏┫┏┫╋┃┃╋┃
            ┗━┻━┻━┻┛┗━┻┻━┛

      Zelretch - Session Generator
""")


async def _generate() -> str:
    try:
        from kurigram import Client
    except ImportError:
        print("Kurigram is not installed. Run: pip install kurigram")
        sys.exit(1)

    api_id = input("Enter your API ID (from https://my.telegram.org): ").strip()
    api_hash = input("Enter your API HASH: ").strip()
    if not (api_id and api_hash):
        print("Both API ID and API HASH are required.")
        sys.exit(1)
    try:
        api_id = int(api_id)
    except ValueError:
        print("API ID must be numeric.")
        sys.exit(1)

    phone = input("Enter your phone number (international format, e.g. +1...): ").strip()
    if not phone:
        print("Phone number is required.")
        sys.exit(1)

    # Use an in-memory client so no .session file is written to disk.
    client = Client(
        name="zelretch-sessiongen",
        api_id=api_id,
        api_hash=api_hash,
        phone_number=phone,
        in_memory=True,
    )
    await client.start()

    me = await client.get_me()
    name = (me.first_name or "") + (" " + me.last_name if me.last_name else "")
    print(f"\n✅ Logged in as {name.strip()} (id={me.id})\n")

    session_string = await client.export_session_string()
    await client.stop()
    return session_string


def main() -> int:
    _banner()
    print("This script will log in to Telegram on your behalf and produce a")
    print("SESSION string. Keep it secret - anyone with it can act as you.\n")
    try:
        session_string = asyncio.run(_generate())
    except KeyboardInterrupt:
        print("\nCancelled.")
        return 1
    except Exception as er:
        print(f"Error: {er}")
        return 1

    print("\n" + "=" * 70)
    print("YOUR ZELRETCH SESSION STRING:")
    print("=" * 70)
    print()
    print(session_string)
    print()
    print("=" * 70)
    print("Paste this into the Zelretch setup wizard's Session step.")
    print("=" * 70)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
